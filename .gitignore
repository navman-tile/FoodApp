# --- Python virtual environment ---
# The venv holds a private copy of Python + all installed packages.
# It's large, machine-specific, and fully rebuildable with:
#   pip install -r requirements.txt
# So we track the recipe (requirements.txt), never the folder itself.
venv/
.venv/

# --- Python bytecode cache ---
# Python compiles .py files to .pyc and stashes them here to start faster.
# Pure build output — regenerated automatically, never edited by hand.
__pycache__/
*.pyc

# --- SQLite database file ---
# Generated by seed.py from data/restaurants.json.
# It's disposable: delete it and re-seed to get back to a known-good state.
# The JSON is our source of truth and IS tracked; the .db is not.
*.db

# --- macOS Finder metadata ---
# Finder drops these hidden files into folders you browse. Noise in a repo.
.DS_Store

# --- Editor / IDE settings ---
# Personal to your machine and editor, not part of the project.
.vscode/
.idea/
